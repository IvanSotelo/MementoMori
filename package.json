{
  "name": "memento-mori",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "lint:js": "eslint .",
    "lint:ts": "vue-tsc --noEmit",
    "lint:prettier": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "lint:style": "stylelint \"**/*.{scss,css}\"",
    "lint": "pnpm run lint:js && pnpm run lint:ts && pnpm run lint:prettier && pnpm run lint:style",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "test": "node --test tests/*.test.ts",
    "commitlint": "commitlint --edit"
  },
  "lint-staged": {
    "*.{cjs,css,js,jsx,json,md,mjs,scss,ts,tsx,vue}": "prettier --write"
  },
  "dependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/image": "2.1.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/seo": "^5.3.14",
    "@pinia/nuxt": "^1.0.2",
    "dom-classes": "^1.0.0",
    "eslint": "^10.9.0",
    "h3": "1.15.11",
    "howler": "^2.2.4",
    "isotope-layout": "^3.0.6",
    "locomotive-scroll": "^4.1.4",
    "nuxt": "^4.5.2",
    "nuxt-gtag": "^5.0.0",
    "pinia": "^4.0.3",
    "swiper": "^12.2.0",
    "unhead": "^3.4.0",
    "vue": "latest",
    "vue-router": "latest"
  },
  "pnpm": {
    "overrides": {
      "unhead": "$unhead",
      "@unhead/vue": "3.4.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@nuxt/schema": "4",
        "unhead": "3"
      }
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@hypernym/nuxt-gsap": "^2.4.3",
    "@types/howler": "^2.2.13",
    "@types/locomotive-scroll": "^4.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "pug": "^3.0.4",
    "pug-plain-loader": "^1.1.0",
    "sass": "^1.103.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-prettier": "^5.0.3",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11"
  }
}
